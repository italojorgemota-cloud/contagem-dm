rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roleDoc() { return get(/databases/$(database)/documents/roles/$(request.auth.uid)); }
    function hasRole() { return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)); }
    function isAdmin() { return hasRole() && roleDoc().data.role == 'gestor'; }
    function myKey()   { return roleDoc().data.key; }
    function bootstrapOpen() { return signedIn() && !exists(/databases/$(database)/documents/config/bootstrap); }

    // Primeiro acesso: enquanto não existe gestor, a tela de entrada pode saber disso
    match /config/bootstrap {
      allow get: if true;
      allow create: if bootstrapOpen();
    }

    // Quem é cada pessoa e o perfil dela (gestor ou op)
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() ||
        (bootstrapOpen() && request.auth.uid == uid && request.resource.data.role == 'gestor');
      allow update, delete: if isAdmin();
    }

    // Lista de usuários (nome e perfil) usada pelo app
    match /users/{k} {
      allow read: if hasRole();
      allow create: if isAdmin() ||
        (bootstrapOpen() && request.resource.data.role == 'gestor' && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Só o gestor lê e grava
    match /erp/{d}   { allow read, write: if isAdmin(); }
    match /addr/{d}  { allow read, write: if isAdmin(); }
    match /apur/{d}  { allow read, write: if isAdmin(); }

    // Todos leem, só o gestor grava
    match /meta/{d}     { allow read: if hasRole(); allow write: if isAdmin(); }
    match /chunks/{d}   { allow read: if hasRole(); allow write: if isAdmin(); }
    match /assign/{d}   { allow read: if hasRole(); allow write: if isAdmin(); }
    match /final/{d}    { allow read: if hasRole(); allow write: if isAdmin(); }
    match /reset/{d}    { allow read: if hasRole(); allow write: if isAdmin(); }
    match /search/{d}   { allow read: if hasRole(); allow write: if isAdmin(); }
    match /gstat/{d}    { allow read: if hasRole(); allow write: if isAdmin(); }
    match /third/{d}    { allow read: if hasRole(); allow write: if isAdmin(); }
    match /addrtask/{d} { allow read: if hasRole(); allow write: if isAdmin(); }

    // Todos leem e gravam; apagar só o gestor
    match /counts/{d}  { allow read: if hasRole(); allow create, update: if hasRole(); allow delete: if isAdmin(); }
    match /extras/{d}  { allow read: if hasRole(); allow create, update: if hasRole(); allow delete: if isAdmin(); }
    match /finds/{d}   { allow read: if hasRole(); allow create, update: if hasRole(); allow delete: if isAdmin(); }
    match /addrnew/{d} { allow read: if hasRole(); allow write: if hasRole(); }

    // Presença ao vivo: cada pessoa grava só a própria linha; o gestor lê todas
    match /ops/{k} {
      allow read: if hasRole();
      allow write: if isAdmin() || (hasRole() && k == myKey());
    }

    match /{other=**} { allow read, write: if false; }
  }
}
